# MongoDB (Atlas connection string)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/psits-test?authSource=admin

# Server
PORT=5000
JWT_SECRET=<your-jwt-secret>
CORS=http://localhost:5173

# Docker host port mappings (optional — defaults used if omitted)
SERVER_PORT=5000
CLIENT_PORT=5173

# Noetix AI Engine
NOETIX_URL=http://localhost:3000
NOETIX_API_KEY=<your-noetix-api-key>
